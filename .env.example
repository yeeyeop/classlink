# 密码重置邮件/企业微信等投递网关；未配置时仅开发环境返回 resetToken。
PASSWORD_RESET_WEBHOOK_URL=
# 仅供自动化测试或无邮件网关的离线答辩演示；生产环境保持 false。
ALLOW_RESET_TOKEN_RESPONSE=false

# 局域网 HTTP 演示请保持 false；部署到 HTTPS 后改为 true。
# 留空时生产环境默认使用 Secure Cookie。
COOKIE_SECURE=false

# 可选：真实教室视频网关基础地址，例如 https://camera.example.edu/live
NEXT_PUBLIC_CAMERA_BASE_URL=

# 默认恢复约 40 MB 的装饰性 GLB 背景；弱网演示可显式设为 false。
NEXT_PUBLIC_ENABLE_GLB_BACKDROP=true

# 冒烟测试使用的数据目录；生产环境也可以指向持久卷。
DATA_DIR=

# 可选：管理员初始化脚本默认值，避免在命令行留下密码。
ADMIN_NAME=平台管理员
ADMIN_SID=2026000001
ADMIN_EMAIL=admin2026@bupt.cn
ADMIN_COLLEGE=信息与通信工程学院
ADMIN_PASSWORD=

# 管理员教室信息助手。留空时使用实时数据规则模式。
# 填 OpenAI 兼容接口地址后，服务端会把实时教室上下文交给你的模型。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=30000
# 可选：追加领域提示词，用于补充学校或课程自己的预约规则。
DEEPSEEK_SYSTEM_PROMPT_EXTRA=

# 通用 OpenAI 兼容模型接口，DEEPSEEK_API_KEY 未配置时使用。
CLASSROOM_ASSISTANT_API_URL=
CLASSROOM_ASSISTANT_API_KEY=
CLASSROOM_ASSISTANT_MODEL=
CLASSROOM_ASSISTANT_TIMEOUT_MS=20000
