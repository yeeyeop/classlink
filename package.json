{
  "name": "zuanyilou-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "node scripts/lan-info.mjs && next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
