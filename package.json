    "admin:create": "node scripts/create-admin.mjs",
    "verify": "npm run test && npm run lint && npm run build && npm run smoke"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
