    "start:lan": "node scripts/lan-info.mjs && next start -H 0.0.0.0 -p 3000",
    "lan:info": "node scripts/lan-info.mjs",
    "lan:share": "node scripts/share-lan.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
